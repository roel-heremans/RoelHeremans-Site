{% extends "base.html.j2" %}
{% from "partials/helpers.html.j2" import img with context %}
{% from "partials/blocks.html.j2" import hand_tested with context %}
{% from "partials/cta.html.j2" import cta with context %}
{% block content %}
{%- set h = content.home %}
{%- set hero = h.hero %}

<section class="hero home-hero">
  <div class="hero__text">
    <p class="eyebrow status">{{ hero.eyebrow | e }}</p>
    <h1 class="display display--hero">{{ hero.before | e }} <span class="fix"><s class="fix__old">{{ hero.old | e }}<svg class="fix__strike" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M2 8.5 C 18 6.5, 34 8.8, 52 6.8 S 84 4.8, 98 4" pathLength="1"/></svg></s> <em class="fix__new">{{ hero.new | e }}</em></span>{{ hero.after | e }}</h1>
    <p class="lead">{{ hero.lead | e }}</p>
    <div class="btn-row">
      <a class="btn btn--accent" href="{{ url('contact') }}">{{ hero.primary | e }}</a>
      <a class="btn btn--outline" href="{{ url('work') }}">{{ hero.secondary | e }}</a>
    </div>
  </div>
  <div class="hero__media">
    {{ img(content.images.portrait_hero, lazy=false, priority=true) }}
{%- set log = h.log %}
    <figure class="vlog" aria-label="{{ log.label | e }}">
      <div class="vlog__head"><span>{{ log.file | e }}</span><span class="vlog__marker">{{ log.marker | e }}</span></div>
      <ol class="vlog__lines">
{%- for line in log.lines %}
        <li><span class="vlog__tag vlog__tag--{{ line.tag }}">{{ line.tag | e }}</span><span>{{ line.text | e }}{% if line.ok is defined %} <span class="vlog__ok">{{ line.ok | e }}</span>{% endif %}</span></li>
{%- endfor %}
      </ol>
      <div class="vlog__foot">{{ log.status | e }} <b>{{ log.status_value | e }}</b></div>
    </figure>
  </div>
</section>

<section class="section section--sm home-facts" aria-label="{{ h.facts.label | e }}">
  <div class="container">
    <dl class="grid grid--3 key-facts">
{%- for fact in h.facts['items'] %}
      <div class="key-fact" data-reveal><dt>{{ fact.value | e }}</dt><dd>{{ fact.text | e }}</dd></div>
{%- endfor %}
    </dl>
  </div>
</section>

<section class="section section--feature home-method">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{{ h.method.eyebrow | e }}</p>
      <h2 class="h-section">{{ h.method.heading | e }}</h2>
      <hr class="rule">
      <p class="lead">{{ content.approach.lead | e }}</p>
    </div>
    <ol class="grid grid--4 step-grid">
{%- for step in content.steps %}
      <li class="step" data-reveal>
        <p class="step__n">{{ content.ui.step | e }} {{ loop.index }}</p>
        <h3 class="h-card">{{ step.name | e }}</h3>
        <p class="step__who">{{ step.who | e }}</p>
      </li>
{%- endfor %}
    </ol>
    <div class="btn-row"><a class="btn btn--outline" href="{{ url('approach') }}">{{ h.method.button | e }}</a></div>
  </div>
</section>

<section class="section home-checked">
  <div class="container container--narrow" data-reveal>
    {{ hand_tested() }}
  </div>
</section>

<section class="section section--alt home-work">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">{{ h.work.eyebrow | e }}</p>
      <h2 class="h-section">{{ h.work.heading | e }}</h2>
    </div>
    <div class="cards cards--2 teasers">
{%- for case in content.work.featured %}
      <article class="card teaser-card" data-reveal>
        <p class="card__eyebrow">{{ case.chips | join(" · ") | e }}</p>
        <h3 class="h-card">{{ case.name | e }}</h3>
        <p class="body">{{ case.paragraphs[0] | e }}</p>
        <div class="btn-row"><a class="text-link" href="{{ url('work') }}#{{ case.id }}">{{ h.work.button | e }}</a></div>
      </article>
{%- endfor %}
    </div>
    <div class="btn-row center"><a class="btn btn--outline" href="{{ url('work') }}">{{ h.work.all | e }}</a></div>
  </div>
</section>

<section class="section section--sm home-bitcoin">
  <div class="container container--narrow">
{%- set b = content.bitcoin %}
    <div class="btc-note" data-reveal>
      <span class="btc-glyph" aria-hidden="true">₿</span>
      <div>
        <p class="eyebrow">{{ b.eyebrow | e }}</p>
        <h2 class="h-card">{{ b.heading | e }}</h2>
        <p class="body">{{ b.text | e }} <a class="text-link" href="{{ url('contact') }}#bitcoin">{{ b.home_link | e }}</a></p>
      </div>
    </div>
  </div>
</section>

{{ cta() }}
{% endblock %}
